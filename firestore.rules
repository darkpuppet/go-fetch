rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (feedback chat additions)
    // ===============================================================
    //
    // Collection: admins
    // Document ID: Firebase Auth uid
    // Fields:
    //   - createdAt: timestamp (optional) - written only by Admin SDK
    // Client writes are denied. A diner cannot grant themselves admin.
    //
    // Collection: feedbackThreads
    // Document ID: diner uid (one thread per user)
    // Fields:
    //   - userId: string (required, immutable, equals document ID)
    //   - userDisplayName: string (required, 1-80)
    //   - lastMessage: string (required, 1-2000)
    //   - lastMessageAt: timestamp (required)
    //   - lastSenderRole: 'user' | 'admin' (required)
    //   - unreadByAdmin: bool (required)
    //   - unreadByUser: bool (required)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Collection: feedbackThreads/{threadId}/messages
    // Fields:
    //   - text: string (required, 1-2000)
    //   - senderId: string (required, equals request.auth.uid)
    //   - senderRole: 'user' | 'admin' (required)
    //   - senderName: string (required, 1-80)
    //   - createdAt: timestamp (required, server time)
    // Messages are immutable after create.
    //
    // Collection: orders
    // Document ID: client-generated auto id
    // Fields:
    //   - orderNumber: string (required, 5 chars, immutable)
    //   - truckId: string (required, immutable, existing foodTrucks id)
    //   - truckName: string (required, immutable, matches the truck name)
    //   - ownerId: string (required, immutable, matches the truck owner)
    //   - customerId: string (required, immutable, equals the signed-in diner)
    //   - customerName: string (required, 1-80, immutable)
    //   - note: string (required, 0-280, immutable)
    //   - status: submitted|accepted|ready|completed|cancelled
    //   - quotedWaitMillis: int (required, 60000-21600000, immutable)
    //   - readyAt: timestamp (optional, owner, set once when status becomes ready)
    //   - completedAt: timestamp (optional, owner, set once when status becomes completed)
    //   - estimatedReadyAt: timestamp (optional, owner, only while submitted or accepted)
    //   - createdAt: timestamp (required, immutable, server time on create)
    //   - updatedAt: timestamp (required, server time)
    //
    // Collection: truckOrderStats
    // Document ID: food truck id
    // Public read. No diner names, notes, or menu lines.
    // Fields:
    //   - truckId: string (required, equals the document id)
    //   - ordersCreated, ordersReady, ordersCompleted, activeOrderCount: int
    //   - totalReadyMillis, totalCompletionMillis, averageReadyMillis: int
    //   - updatedAt: timestamp (required, server time)
    // Clients cannot write this document. syncTruckOrderWait (Admin SDK)
    // recomputes it from real orders. Counts and durations stay bounded.
    // The order form reads this before an order exists.
    //
    // Collection: foodTrucks menu
// menuById is the orderable catalog, at most 40 items, keyed by menu item id.
// menuItems is the same list for older clients and must be the same length.
// An order line is checked against that one menuById entry: name, price,
// and category must match, and those fields must stay within size limits.
//
// defaultWaitMillis: int (optional). Whole minutes from 2 to 45.
// The owner sets it. Diners use it when the truck has no finished orders.
// It is public because the order form shows a wait before an order exists.
    //
    // Collection: orders/{orderId}/items
    // Fields:
    //   - orderId: string (required, equals the parent id)
    //   - menuItemId, name, quantity, price, category
    //   - ownerId, customerId (copied from the parent order)
    // Lines can be created only in the same request as the order, and only
    // for an item on that truck's published menu.
    // Diners create and read their own orders. The truck owner reads them and
    // may update status only. Orders are not public.
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidMenuCatalog(data) {
      return !('menuById' in data)
        || (
          data.menuById is map
          && data.menuById.size() <= 40
          && data.menuItems is list
          && data.menuItems.size() == data.menuById.size()
          && data.menuItems.size() <= 40
        );
    }

    function isValidDefaultWait(data) {
      return !('defaultWaitMillis' in data)
        || (
          data.defaultWaitMillis is int
          && data.defaultWaitMillis >= 120000
          && data.defaultWaitMillis <= 2700000
          && data.defaultWaitMillis % 60000 == 0
        );
    }

    function isValidTruckData(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.cuisine is string
        && data.cuisine.size() > 0
        && data.cuisine.size() <= 200
        && data.status is string
        && data.status.size() <= 40
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.location is map
        && data.location.keys().hasOnly(['lat', 'lng'])
        && data.location.lat is number
        && data.location.lng is number
        && data.location.lat >= -90
        && data.location.lat <= 90
        && data.location.lng >= -180
        && data.location.lng <= 180
        && isValidMenuCatalog(data)
        && isValidDefaultWait(data);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;

      allow delete: if false;
    }

    match /foodTrucks/{truckId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidTruckData(request.resource.data);

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && isValidTruckData(request.resource.data);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isValidSpotData(data) {
      return data.reportedBy is string
        && data.photoUrl is string
        && data.photoUrl.size() > 0
        && data.location is map
        && data.location.lat is number
        && data.location.lng is number
        && data.location.lat >= -90
        && data.location.lat <= 90
        && data.location.lng >= -180
        && data.location.lng <= 180
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && (!('truckId' in data) || data.truckId is string);
    }

    match /truckSpots/{spotId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && isValidSpotData(request.resource.data);

      allow delete: if isSignedIn()
        && resource.data.reportedBy == request.auth.uid;

      allow update: if false;
    }

    function isValidFoodPhotoData(data) {
      return data.truckId is string
        && data.truckId.size() > 0
        && data.photoUrl is string
        && data.photoUrl.size() > 0
        && data.uploadedBy is string
        && exists(/databases/$(database)/documents/foodTrucks/$(data.truckId));
    }

    match /truckFoodPhotos/{photoId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && isValidFoodPhotoData(request.resource.data);

      allow delete: if isSignedIn()
        && resource.data.uploadedBy == request.auth.uid;

      allow update: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }

    function isValidFeedbackThread(data) {
      return data.keys().hasOnly([
          'userId',
          'userDisplayName',
          'lastMessage',
          'lastMessageAt',
          'lastSenderRole',
          'unreadByAdmin',
          'unreadByUser',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.userDisplayName is string
        && data.userDisplayName.size() > 0
        && data.userDisplayName.size() <= 80
        && data.lastMessage is string
        && data.lastMessage.size() > 0
        && data.lastMessage.size() <= 2000
        && data.lastMessageAt is timestamp
        && data.lastSenderRole in ['user', 'admin']
        && data.unreadByAdmin is bool
        && data.unreadByUser is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function feedbackThreadIdentityUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isUserFeedbackReadReceipt() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unreadByUser', 'updatedAt'])
        && request.resource.data.unreadByUser == false
        && request.resource.data.updatedAt == request.time;
    }

    function isAdminFeedbackReadReceipt() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unreadByAdmin', 'updatedAt'])
        && request.resource.data.unreadByAdmin == false
        && request.resource.data.updatedAt == request.time;
    }

    function isUserSendingFeedback() {
      return request.resource.data.lastSenderRole == 'user'
        && request.resource.data.unreadByAdmin == true
        && request.resource.data.unreadByUser == false
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isAdminSendingFeedback() {
      return request.resource.data.lastSenderRole == 'admin'
        && request.resource.data.unreadByUser == true
        && request.resource.data.unreadByAdmin == false
        && request.resource.data.userDisplayName == resource.data.userDisplayName
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidFeedbackMessage(data) {
      return data.keys().hasOnly(['text', 'senderId', 'senderRole', 'senderName', 'createdAt'])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.senderId is string
        && data.senderId.size() > 0
        && data.senderId.size() <= 128
        && data.senderRole in ['user', 'admin']
        && data.senderName is string
        && data.senderName.size() > 0
        && data.senderName.size() <= 80
        && data.createdAt is timestamp;
    }

    match /feedbackThreads/{threadId} {
      allow read: if isSignedIn() && (request.auth.uid == threadId || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == threadId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == threadId
        && request.resource.data.lastSenderRole == 'user'
        && request.resource.data.unreadByAdmin == true
        && request.resource.data.unreadByUser == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && isValidFeedbackThread(request.resource.data);

      allow update: if isSignedIn()
        && isValidFeedbackThread(request.resource.data)
        && feedbackThreadIdentityUnchanged()
        && (
          (isOwner(resource.data.userId)
            && request.auth.uid == threadId
            && (isUserFeedbackReadReceipt() || isUserSendingFeedback()))
          || (isAdmin() && (isAdminFeedbackReadReceipt() || isAdminSendingFeedback()))
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == threadId || isAdmin());

        allow create: if isSignedIn()
          && existsAfter(/databases/$(database)/documents/feedbackThreads/$(threadId))
          && isValidFeedbackMessage(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (request.auth.uid == threadId
              && request.resource.data.senderRole == 'user'
              && getAfter(/databases/$(database)/documents/feedbackThreads/$(threadId)).data.userId
                == request.auth.uid)
            || (isAdmin()
              && request.resource.data.senderRole == 'admin'
              && request.resource.data.senderName == 'Go Fetch')
          );

        allow update, delete: if false;
      }
    }

    function isValidOrderLine(data) {
      return data.keys().hasOnly([
          'orderId',
          'menuItemId',
          'name',
          'quantity',
          'price',
          'category',
          'ownerId',
          'customerId'
        ])
        && data.orderId is string
        && data.orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.menuItemId is string
        && data.menuItemId.size() > 0
        && data.menuItemId.size() <= 80
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 20
        && data.price is string
        && data.price.size() <= 24
        && data.category is string
        && data.category.size() <= 40
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 128;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasOnly([
          'orderNumber',
          'truckId',
          'truckName',
          'ownerId',
          'customerId',
          'customerName',
          'note',
          'status',
          'quotedWaitMillis',
          'readyAt',
          'completedAt',
          'estimatedReadyAt',
          'createdAt',
          'updatedAt'
        ])
        && data.orderNumber is string
        && data.orderNumber.matches('^[2-9A-HJ-NP-Z]{5}$')
        && data.truckId is string
        && data.truckId.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.truckName is string
        && data.truckName.size() > 0
        && data.truckName.size() <= 120
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 128
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 80
        && data.note is string
        && data.note.size() <= 280
        && data.status in ['submitted', 'accepted', 'ready', 'completed', 'cancelled']
        && data.quotedWaitMillis is int
        && data.quotedWaitMillis >= 60000
        && data.quotedWaitMillis <= 21600000
        && optionalTimestamp(data, 'readyAt')
        && optionalTimestamp(data, 'completedAt')
        && optionalTimestamp(data, 'estimatedReadyAt')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTruckOrderStats(data) {
      return data.keys().hasOnly([
          'truckId',
          'ordersCreated',
          'ordersReady',
          'ordersCompleted',
          'totalReadyMillis',
          'totalCompletionMillis',
          'activeOrderCount',
          'averageReadyMillis',
          'updatedAt'
        ])
        && data.truckId is string
        && data.truckId.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.ordersCreated is int
        && data.ordersCreated >= 0
        && data.ordersCreated <= 100000
        && data.ordersReady is int
        && data.ordersReady >= 0
        && data.ordersReady <= data.ordersCreated
        && data.ordersCompleted is int
        && data.ordersCompleted >= 0
        && data.ordersCompleted <= data.ordersCreated
        && data.activeOrderCount is int
        && data.activeOrderCount >= 0
        && data.activeOrderCount <= data.ordersCreated
        && data.totalReadyMillis is int
        && data.totalReadyMillis >= 0
        && data.totalReadyMillis <= data.ordersReady * 2700000
        && data.totalCompletionMillis is int
        && data.totalCompletionMillis >= 0
        && data.totalCompletionMillis <= data.ordersCompleted * 2700000
        && data.averageReadyMillis is int
        && data.averageReadyMillis >= 120000
        && data.averageReadyMillis <= 2700000
        && data.updatedAt is timestamp;
    }

    function orderMatchesTruck(data) {
      return exists(/databases/$(database)/documents/foodTrucks/$(data.truckId))
        && get(/databases/$(database)/documents/foodTrucks/$(data.truckId)).data.ownerId == data.ownerId
        && get(/databases/$(database)/documents/foodTrucks/$(data.truckId)).data.name == data.truckName;
    }

    function orderIdentityUnchanged() {
      return request.resource.data.orderNumber == resource.data.orderNumber
        && request.resource.data.truckId == resource.data.truckId
        && request.resource.data.truckName == resource.data.truckName
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.note == resource.data.note
        && request.resource.data.quotedWaitMillis == resource.data.quotedWaitMillis
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isOwnerOrderUpdate() {
      return isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && isValidOrder(request.resource.data)
        && orderIdentityUnchanged()
        && request.resource.data.updatedAt == request.time;
    }

    function isOwnerStatusProgress() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status in ['submitted', 'accepted']
        && request.resource.data.status in ['accepted', 'cancelled'];
    }

    function isOwnerMarkReady() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'readyAt'])
        && resource.data.status in ['submitted', 'accepted']
        && request.resource.data.status == 'ready'
        && !('readyAt' in resource.data)
        && request.resource.data.readyAt == request.time;
    }

    function isOwnerMarkCompleted() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt'])
        && resource.data.status == 'ready'
        && request.resource.data.status == 'completed'
        && !('completedAt' in resource.data)
        && request.resource.data.completedAt == request.time;
    }

    function isOwnerEstimateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estimatedReadyAt', 'updatedAt'])
        && resource.data.status in ['submitted', 'accepted']
        && request.resource.data.status == resource.data.status
        && request.resource.data.estimatedReadyAt >= request.time - duration.value(2, 'm')
        && request.resource.data.estimatedReadyAt <= request.time + duration.value(6, 'h');
    }

    match /orders/{orderId} {
      function orderLineMatchesPublishedMenu() {
        let truckId = getAfter(/databases/$(database)/documents/orders/$(orderId)).data.truckId;
        let item = get(/databases/$(database)/documents/foodTrucks/$(truckId)).data.menuById[request.resource.data.menuItemId];
        return item.name is string
          && item.name.size() > 0
          && item.name.size() <= 80
          && item.price is string
          && item.price.size() <= 24
          && item.category is string
          && item.category.size() <= 40
          && item.name == request.resource.data.name
          && item.price == request.resource.data.price
          && item.category == request.resource.data.category;
      }

      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidOrder(request.resource.data)
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !('readyAt' in request.resource.data)
        && !('completedAt' in request.resource.data)
        && !('estimatedReadyAt' in request.resource.data)
        && orderMatchesTruck(request.resource.data);

      allow update: if isOwnerOrderUpdate() && (
        isOwnerStatusProgress()
        || isOwnerMarkReady()
        || isOwnerMarkCompleted()
        || isOwnerEstimateUpdate()
      );

      allow delete: if false;

      match /items/{itemId} {
        allow read: if isSignedIn() && (
          resource.data.customerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

        allow create: if isSignedIn()
          && isValidOrderLine(request.resource.data)
          && request.resource.data.orderId == orderId
          && request.resource.data.customerId == request.auth.uid
          && existsAfter(/databases/$(database)/documents/orders/$(orderId))
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.ownerId == request.resource.data.ownerId
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.createdAt == request.time
          && orderLineMatchesPublishedMenu();

        allow update, delete: if false;
      }
    }

    match /truckOrderStats/{truckId} {
      allow read: if true;

      // Admin SDK (syncTruckOrderWait) is the only writer. A truck owner
      // cannot publish a wait that the latest orders do not support.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
